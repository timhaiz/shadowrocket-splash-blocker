#!name=开屏去广告 - 合并版
#!desc=高德地图、航旅纵横、中国国航、京东、淘宝、滴滴；Shadowrocket 需手动添加 HTTPS 解密域名
#!system=ios

[Script]
高德地图_开屏去广告 = type=http-response, requires-body=true, max-size=0, pattern=^https?:\/\/(?:amap-aos-info-nogw|m\d+)\.amap\.com\/ws\/(?:aos\/alimama\/splash_screen(?:_rt)?|shield\/dsp\/app\/startup\/init|valueadded\/alimama\/splash_screen)(?:[/?]|$), script-path=https://raw.githubusercontent.com/timhaiz/shadowrocket-splash-blocker/main/scripts/splash-blocker.js, timeout=10
航旅纵横_开屏广告位 = type=http-response, requires-body=false, pattern=^https?:\/\/(?:umerp\.umetrip\.com(?:\.cn)?|home\.umetrip\.com|bkclient\.umetrip\.com\.cn)\/gateway\/api\/umetrip\/native(?:[/?]|$), script-path=https://raw.githubusercontent.com/timhaiz/shadowrocket-splash-blocker/main/scripts/splash-blocker.js, timeout=10
航旅纵横_开屏广告资源 = type=http-response, requires-body=false, pattern=^https?:\/\/oss\.umetrip\.com\/fs\/advert\/polite(?:[/?]|$), script-path=https://raw.githubusercontent.com/timhaiz/shadowrocket-splash-blocker/main/scripts/splash-blocker.js, timeout=10
中国国航_开屏去广告 = type=http-response, requires-body=false, pattern=^https?:\/\/m\.airchina\.com\.cn\/airchina\/gateway\/v\d+(?:\.\d+)*\/api\/services(?:[/?]|$), script-path=https://raw.githubusercontent.com/timhaiz/shadowrocket-splash-blocker/main/scripts/splash-blocker.js, timeout=10
京东_开屏去广告 = type=http-response, requires-body=true, max-size=0, pattern=^https?:\/\/api\.m\.jd\.com\/client\.action\?(?=[^#]*\bfunctionId=start(?:&|$)), script-path=https://raw.githubusercontent.com/timhaiz/shadowrocket-splash-blocker/main/scripts/splash-blocker.js, timeout=10
淘宝_开屏去广告 = type=http-response, requires-body=true, max-size=0, pattern=^https?:\/\/guide-acs\.m\.taobao\.com\/gw\/mtop\.taobao\.(?:cloudvideo\.video\.query|wireless\.home\.splash\.awesome\.get)(?:[/?]|$), script-path=https://raw.githubusercontent.com/timhaiz/shadowrocket-splash-blocker/main/scripts/splash-blocker.js, timeout=10
滴滴_开屏去广告 = type=http-response, requires-body=true, max-size=0, pattern=^https?:\/\/(?:hd\.xiaojukeji\.com\/d(?:[/?]|$)|res\.xiaojukeji\.com\/resapi\/activity\/(?:m|xp)get(?:[/?]|$)), script-path=https://raw.githubusercontent.com/timhaiz/shadowrocket-splash-blocker/main/scripts/splash-blocker.js, timeout=10

[MITM]
# Shadowrocket 部分版本不会自动合并本段，请在“HTTPS 解密”中手动添加以下域名。
hostname = %APPEND% amap-aos-info-nogw.amap.com, m*.amap.com, umerp.umetrip.com, umerp.umetrip.com.cn, home.umetrip.com, bkclient.umetrip.com.cn, oss.umetrip.com, m.airchina.com.cn, api.m.jd.com, guide-acs.m.taobao.com, hd.xiaojukeji.com, res.xiaojukeji.com
